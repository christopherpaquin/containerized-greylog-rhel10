# Graylog Stack - Environment Configuration
#
# Copy this file to `.env` and adjust as needed:
#   cp .env.example .env
#
# `.env` is the single source of truth for every configurable value in this
# deployment. It is loaded (bash-sourced) by deploy.sh, healthcheck.sh and
# uninstall.sh. Do not hard-code these values anywhere else.
#
# `.env` is gitignored on purpose - it ends up holding generated secrets.
# Secret-shaped values below (marked GENERATED) are created automatically by
# deploy.sh on first run if left blank, and are then preserved on every
# subsequent run so reruns never rotate credentials.
#
# This file is parsed with `bash -a source`, so:
#   - no spaces around "="
#   - values may reference earlier variables, e.g. FOO="${DATA_ROOT}/foo"
#   - quote any value containing spaces or special shell characters

############################################
# Container images (pinned - never :latest)
############################################
# Versions validated against the Graylog 7.1 compatibility matrix:
# https://go2docs.graylog.org/current/downloading_and_installing_graylog/compatibility_matrix.htm
# Graylog 7.1 supports MongoDB 7.x - 8.2.x and ships OpenSearch inside Data Node
# (no separate OpenSearch/Elasticsearch container is required or deployed).

GRAYLOG_IMAGE=docker.io/graylog/graylog
GRAYLOG_VERSION=7.1.7

DATANODE_IMAGE=docker.io/graylog/graylog-datanode
DATANODE_VERSION=7.1.7

MONGODB_IMAGE=docker.io/library/mongo
MONGODB_VERSION=8.2.12

############################################
# Project / container / network naming
############################################
PROJECT_NAME=graylog-stack
NETWORK_NAME=graylog-net

MONGODB_CONTAINER_NAME=mongodb
DATANODE_CONTAINER_NAME=graylog-datanode
GRAYLOG_CONTAINER_NAME=graylog

############################################
# Persistent storage (host bind mounts)
############################################
# All application data lives under DATA_ROOT. Each subdirectory is bind
# mounted into exactly one container, owned by that container's runtime UID,
# and labeled container_file_t for SELinux (see docs/selinux.md).
DATA_ROOT=/var/lib/graylog-stack

MONGODB_DB_DIR="${DATA_ROOT}/mongodb/db"
MONGODB_CONFIGDB_DIR="${DATA_ROOT}/mongodb/configdb"
DATANODE_DATA_DIR="${DATA_ROOT}/datanode"
GRAYLOG_DATA_DIR="${DATA_ROOT}/graylog"

# Root-only directory holding generated secret material referenced by Podman
# secrets and the one-time-display admin password file.
SECRETS_DIR="${DATA_ROOT}/secrets"

############################################
# Network ports
############################################
# Published externally on the host (firewalld-managed):
GRAYLOG_HTTP_PORT=9000
SYSLOG_TCP_PORT=1514
SYSLOG_UDP_PORT=1514

# MongoDB and Data Node are NEVER published to the host. They are reachable
# only from other containers on NETWORK_NAME. Do not add PublishPort= for
# them in the Quadlet units.

############################################
# Graylog web / API
############################################
# External URL operators and browsers use to reach the web UI. Leave blank
# to have deploy.sh auto-detect the host's primary IP on first run and
# persist it here (idempotent - later runs reuse the stored value even if
# detection would now return something different).
GRAYLOG_HTTP_EXTERNAL_URI=

# Graylog's built-in initial admin account. Username is configurable;
# password is never stored in plaintext in .env (see GRAYLOG_ROOT_PASSWORD_SHA2).
GRAYLOG_ROOT_USERNAME=admin
GRAYLOG_ROOT_EMAIL=admin@example.invalid

############################################
# Graylog secrets (GENERATED - do not hand-edit unless you know why)
############################################
# 96-char pepper used to secure stored user passwords/encrypted values.
# MUST be identical between the Graylog server and the Data Node - deploy.sh
# stores this once as a Podman secret and reuses it for both containers.
GRAYLOG_PASSWORD_SECRET=

# SHA-256 hash of the initial admin password. deploy.sh generates a random
# password on first run, stores the hash here, and writes the one-time
# plaintext to ${SECRETS_DIR}/admin_password.txt (root-only, 0600) so it can
# be retrieved after the fact. Set this yourself if you want a known password:
#   echo -n 'yourpassword' | sha256sum | cut -d' ' -f1
GRAYLOG_ROOT_PASSWORD_SHA2=

############################################
# Graylog Data Node / TLS
############################################
# Graylog's built-in self-signed-CA mechanism: on first start the Graylog
# server generates a self-signed CA, signs Data Node's HTTP + transport
# certificates automatically, and skips the interactive preflight wizard.
# Replaces the deprecated, unencrypted `insecure_startup` flag.
GRAYLOG_SELFSIGNED_STARTUP=true

# Certificate lifetime applied to the renewal policy after first start
# (ISO-8601 duration). Default renewal policy is 30 days; this deployment
# requests 10-year certificates instead. Automatic renewal remains enabled,
# so a cert is still reissued if it is ever manually revoked/expired.
DATANODE_CERT_LIFETIME=P3650D

############################################
# MongoDB
############################################
MONGO_INITDB_DATABASE=graylog

# GENERATED on first run and preserved thereafter. Only applied by the
# mongo image on an empty data directory, so changing these after the first
# deploy has no effect until MONGODB_DB_DIR is purged.
MONGO_INITDB_ROOT_USERNAME=graylog
MONGO_INITDB_ROOT_PASSWORD=

############################################
# JVM / memory sizing
############################################
# Leave blank to have deploy.sh detect total host RAM and size these on
# first run (then persist the result here - later runs reuse it even if
# detection would now return something different, so it's safe to hand-tune
# afterward). Follows Graylog's own guidance: ~50% of RAM to the Data Node's
# embedded OpenSearch heap (capped at 31g - the JVM compressed-oops
# ceiling), ~25% to Graylog server (capped at 4g - it's far less
# heap-hungry than OpenSearch). See docs/sizing.md before overriding.
GRAYLOG_SERVER_JAVA_OPTS=
DATANODE_OPENSEARCH_HEAP=

############################################
# Misc
############################################
TZ=UTC

############################################
# Firewall
############################################
# Whether deploy.sh manages firewalld rules for GRAYLOG_HTTP_PORT and
# SYSLOG_TCP_PORT/SYSLOG_UDP_PORT. Ports are opened on the active zone for
# any source (POC default). Set to "false" to manage firewall rules
# yourself (deploy.sh will then only warn if the ports look closed).
MANAGE_FIREWALL=true
